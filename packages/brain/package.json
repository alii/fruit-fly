{
	"name": "@fly/brain",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build:data": "uv run --with pyarrow --with pandas --with numpy python3 ../../scripts/build_brain.py",
		"example": "bun run examples/giant-fiber.ts",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit -p .",
		"gen:channels": "bun run scripts/gen-channels.ts",
		"format": "prettier --write --ignore-path ../../.prettierignore ../..",
		"format:check": "prettier --check --ignore-path ../../.prettierignore ../.."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "latest",
		"eslint": "^10.10.0",
		"eslint-plugin-functional": "^10.0.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9",
		"typescript-eslint": "^8.70.0"
	}
}
